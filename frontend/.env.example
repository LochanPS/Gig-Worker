# Frontend build-time env (Vite). Copy to frontend/.env.local for local dev, or set
# in the Vercel/Cloudflare Pages project settings for prod. Vite inlines these at
# BUILD time — changing one needs a rebuild, not just a restart.

# Backend origin. Leave EMPTY for local dev — Vite proxies /api to localhost:4000.
# In prod set it to the origin that serves /api (on a Vercel multi-service deploy
# that is your own production URL, because /api is rewritten to the backend service).
# NOTE: on a hosted build an empty value falls back to the Railway backend baked
# into src/lib/api.ts, so set this explicitly in production.
VITE_API_BASE=

# Which chain the deployed contracts live on. This drives the block-explorer links
# shown next to every tx hash (fund / release / credential anchor).
#   31337    = local anvil  — no public explorer, hashes render as plain text
#   84532    = Base Sepolia — https://sepolia.basescan.org   <- use this for the demo
#   11155111 = Ethereum Sepolia
#   80002    = Polygon Amoy
# Leave unset for local dev; set to 84532 when demoing against the public testnet,
# or the "open it on BaseScan" moment silently degrades to inert text.
VITE_CHAIN_ID=
