# Frontend build-time env (Vite). Copy to frontend/.env.local for local dev, or set
# in Vercel/Cloudflare Pages project settings for prod.

# Backend origin in PRODUCTION (frontend and backend on different domains).
# Leave EMPTY for local dev — Vite proxies /api to localhost:4000.
# Example: https://gigbridge-backend.onrender.com
VITE_API_BASE=
