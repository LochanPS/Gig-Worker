# GigBridge backend environment — copy to .env for local dev.
# All keys below are DEMO ONLY. Never put real secrets or real private keys here.

DATABASE_URL=postgresql://gigbridge:gigbridge@localhost:5432/gigbridge
JWT_SECRET=dev-only-change-me

# Chain (anvil local dev chain)
RPC_URL=http://localhost:8545
CHAIN_ID=31337
# anvil well-known account 0 — DEMO ONLY, publicly known key, never holds real funds
PLATFORM_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ---------------------------------------------------------------------------
# REAL TESTNET (Base Sepolia) — see docs/GO_LIVE_PLAN.md §3.
# Uncomment + fill to run a genuinely on-chain payment (free, uses test ETH).
# The keys below are a FRESH testnet wallet you control — NEVER one with real funds,
# and never committed. Put them in the host's secret store, not this file.
# ---------------------------------------------------------------------------
# RPC_URL=https://sepolia.base.org            # or an Alchemy/Infura Base Sepolia URL
# CHAIN_ID=84532
# PLATFORM_PRIVATE_KEY=0x<your funded testnet key>
# DEPLOYER_PRIVATE_KEY=0x<your funded testnet key>
# TREASURY_ADDRESS=0x<your wallet address>    # fee collector; defaults to deployer
# SETTLEMENT_MODE=real                        # real on-chain settlement (else simulated)
# SETTLEMENT_STRICT=true                      # refuse to boot if real settlement can't start,
#                                             # instead of silently falling back to simulated
#                                             # (whose tx hashes look real but resolve nowhere)
# The wallets each demo actor transacts from, email -> private key. Without this the seed
# gives every actor a random, UNFUNDED key and real settlement cannot sign. Malformed JSON
# is ignored silently — run `pnpm --filter ./contracts preflight:chain` to catch that.
# PLATFORM_PRIVATE_KEY must be the SAME key as DEPLOYER_PRIVATE_KEY: mint and attest are
# onlyOwner(deployer), and EscrowVault grants PLATFORM_ROLE only to its deploy-time admin.
# DEMO_WALLET_KEYS={"novatek@demo.gg":"0x<payer key>","priya@demo.gg":"0x<payee key>"}
# Optional: inline deployed addresses for ephemeral hosts (else commit shared/abis/addresses.84532.json)
# DEPLOYED_ADDRESSES={"chainId":84532,"MockUSDC":"0x..","IdentityRegistry":"0x..","EscrowVault":"0x..","AuditAnchor":"0x.."}

# LLM agent (optional — empty triggers deterministic template explanations)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# FX
FX_API_URL=https://api.frankfurter.app
FX_OFFLINE=false

# Fees & rate lock (see docs/BUILD_CONTRACTS.txt section 8)
FEE_BPS=75
FEE_MIN_USD=1
RATE_LOCK_MINUTES=10

# Server
PORT=4000
NODE_ENV=development
